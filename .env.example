# ============================================
# Estado Diario CRM - Environment Variables
# ============================================

# Environment: development | testing | production
APP_ENV=development

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=estado_diario_db
POSTGRES_USER=estado_diario_user
POSTGRES_PASSWORD=change_me_in_production

# ---- Backend (FastAPI) ----
BACKEND_PORT=8091
BACKEND_SECRET_KEY=change-this-secret-key-in-production
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:8090
BACKEND_LOG_LEVEL=INFO

# ---- Frontend (Angular) ----
FRONTEND_PORT=8090

# ---- pgAdmin ----
PGADMIN_DEFAULT_EMAIL=admin@estadodiario.cl
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050
