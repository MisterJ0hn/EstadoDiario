# ============================================
# Estado Diario CRM - Environment Variables
# ============================================

# Environment: development | testing | production
APP_ENV=development

# ---- PostgreSQL (instalado en el host Linux, NO en Docker) ----
# Desde los contenedores: host.docker.internal (requiere extra_hosts: host-gateway)
# Ejecutando el backend fuera de Docker: localhost
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=estado_diario_db
POSTGRES_USER=estado_diario_user
POSTGRES_PASSWORD=change_me_in_production

# ---- Backend (FastAPI) ----
BACKEND_PORT=8091
BACKEND_SECRET_KEY=change-this-secret-key-in-production
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_REFRESH_TOKEN_EXPIRE_DAYS=7
# Vigencia del enlace de recuperación de contraseña que se manda por correo.
# Corto a propósito: permite cambiar la clave sin saber la anterior.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=http://localhost:8090
BACKEND_LOG_LEVEL=INFO

# ---- Ingesta por correo ----
# Clave Fernet para cifrar la contraseña de la casilla IMAP.
# Si se deja vacía se deriva de BACKEND_SECRET_KEY. Cambiarla obliga a
# volver a escribir la contraseña desde la UI.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_ENCRYPTION_KEY=
TIMEZONE=America/Santiago

# ---- Google Calendar / WhatsApp (Twilio) ----
# URL pública del sitio, sin barra final. Define el redirect_uri de Google
# OAuth (https://PUBLIC_BASE_URL/api/v1/google-calendar/callback), a dónde
# vuelve el navegador tras conectar, y el enlace de recuperación de contraseña
# que se manda por correo (https://PUBLIC_BASE_URL/restablecer-clave?token=...):
# mal puesta, el correo llega con un enlace que no abre nada. El Client
# ID/Secret de Google y las credenciales de Twilio se configuran desde la app
# (Administración), no acá.
PUBLIC_BASE_URL=https://ed.temposoft.cl

# ---- reCAPTCHA v3 (invisible, por puntaje) ----
# APAGADO mientras estas dos estén vacías: sin ellas el backend no llama a
# Google y los formularios públicos se comportan exactamente como antes.
#
# Las llaves se crean en https://www.google.com/recaptcha/admin eligiendo el
# tipo v3, y van EN PAREJA: la site key es pública y la sirve
# GET /api/v1/auth/recaptcha; el secret nunca sale del servidor. Registrar ahí
# los dominios que sirven las SPA. Para desarrollo conviene un par APARTE con
# localhost: meter localhost en la llave de producción degrada los puntajes
# reales. Tienen que ser LAS MISMAS en backend y admin_api.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Bajo este puntaje se rechaza (0.0 bot seguro, 1.0 humano seguro). 0.5 es el
# default de Google. En localhost casi todo da 0.9, así que NO se puede
# calibrar ahí: sale de los datos del modo monitor de más abajo.
RECAPTCHA_SCORE_MINIMO=0.5
# Modo monitor: verifica y deja el puntaje en el log, pero NO rechaza a nadie.
# Es como hay que estrenarlo en producción — ver DEPLOY.md.
RECAPTCHA_SOLO_REGISTRAR=false
# Google caído o inalcanzable → dejar pasar. En false, una caída de Google
# bloquea todos los ingresos: solo para estar bajo ataque activo.
RECAPTCHA_FALLA_ABIERTA=true
# Hostnames aceptados, separados por coma. Vacío = se confía en la
# verificación de dominio de la consola de Google, que es lo normal.
RECAPTCHA_HOSTNAMES=

# ---- reCAPTCHA de la app Android (opcional) ----
# El APK corre en un WebView cuyo origen es https://localhost. Ese dominio no
# se puede registrar en la llave de arriba sin degradar los puntajes reales de
# la web, así que la app lleva su PROPIO par v3, con `localhost` registrado.
#
# Vacíos, el APK usa la llave de la web y vuelve a fallar el login: es
# exactamente el problema que este par resuelve. El backend elige uno u otro
# mirando el `Origin` de cada petición.
#
# Van solo en el backend de estudios; admin_api no los necesita.
RECAPTCHA_SITE_KEY_APP=
RECAPTCHA_SECRET_KEY_APP=
# Orígenes que usan ese par, separados por coma. Solo se cambia si el WebView
# deja de servirse desde https://localhost (ver androidScheme en
# ionic_app/capacitor.config.ts).
RECAPTCHA_ORIGENES_APP=https://localhost

# ---- Frontend (Angular) ----
FRONTEND_PORT=8090
